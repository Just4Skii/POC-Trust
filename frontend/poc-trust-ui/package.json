{
  "name": "poc-trust-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "i18n:sync": "node scripts/i18n-meta.mjs",
    "check:i18n": "node scripts/i18n-meta.mjs --check && node scripts/check-i18n.mjs && node scripts/test-i18n-drift.mjs",
    "check:contract": "node scripts/contract-check.mjs && node scripts/copy-guard.mjs && node scripts/i18n-meta.mjs --check && node scripts/check-i18n.mjs && node scripts/test-i18n-drift.mjs",
    "check:copy": "node scripts/copy-guard.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}

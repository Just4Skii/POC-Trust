# POC Trust — demonstration appliance configuration.
# Copy to .env and fill in the values you need. Everything here is OPTIONAL;
# the appliance runs fully offline with the stub advisory provider.

# ── Advisory AI (server-side only — never shipped to the browser) ─────────────
# Any OpenAI-compatible chat-completions endpoint works. Gemini example:
AI_API_KEY=
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-2.0-flash

# ── Optional API-key gate for mutating endpoints (auth stub) ──────────────────
# Set AUTH_MODE=apikey and choose a key; POST/PUT/PATCH/DELETE then require X-Api-Key.
AUTH_MODE=none
AUTH_API_KEY=

# ── Appliance knobs ────────────────────────────────────────────────────────────
POC_TRUST_PORT=8080
DEMO_AUTOSEED=true
RATE_LIMIT_PERMITS=100
RATE_LIMIT_WINDOW=10

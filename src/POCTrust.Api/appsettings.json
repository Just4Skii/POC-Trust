{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=poctrust.db"
  },
  "AI": {
    "Provider": "openai-compatible",
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "Model": "gpt-4o-mini",
    "ApiKey": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "RateLimit": {
    "PermitsPerWindow": 100,
    "WindowSeconds": 10
  },
  "Auth": {
    "Mode": "none",
    "ApiKey": ""
  },
  "Frontend": {
    "Serve": true
  }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>12a2d5b3-8c17-480c-b864-ee8fe97e5408</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
    <!-- Pin the transitive Microsoft.OpenApi to the patched 2.x line (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451,
         fixed in 2.7.5). Microsoft.AspNetCore.OpenApi 10.0.6 otherwise resolves the vulnerable 2.0.0. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\POCTrust.Core\POCTrust.Core.csproj" />
    <ProjectReference Include="..\POCTrust.Infrastructure\POCTrust.Infrastructure.csproj" />
  </ItemGroup>

</Project>
